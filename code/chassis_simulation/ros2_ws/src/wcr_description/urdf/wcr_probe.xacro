<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Project inspection frame: +X forward, +Y robot left, +Z away from steel. -->
  <joint name="base_surface_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_surface"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="base_surface"/>

  <joint name="probe_rail_support_joint" type="fixed">
    <parent link="base_surface"/>
    <child link="probe_rail_support_link"/>
    <origin xyz="${probe_rail_origin_x} 0 ${probe_rail_origin_z}" rpy="0 0 0"/>
  </joint>
  <link name="probe_rail_support_link">
    <visual>
      <geometry><box size="0.018 ${probe_rail_length} 0.018"/></geometry>
      <material name="gray"/>
    </visual>
  </link>

  <joint name="probe_rail_joint" type="prismatic">
    <parent link="probe_rail_support_link"/>
    <child link="probe_rail_carriage_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${probe_rail_minimum}" upper="${probe_rail_maximum}"
      effort="100" velocity="0.03"/>
    <dynamics damping="10.0" friction="10.0"/>
  </joint>
  <link name="probe_rail_carriage_link">
    <inertial>
      <mass value="0.25"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry><box size="0.040 0.055 0.025"/></geometry>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="ultrasonic_probe_joint" type="fixed">
    <parent link="probe_rail_carriage_link"/>
    <child link="ultrasonic_probe_link"/>
    <origin xyz="${probe_camera_offset_x} 0 ${probe_acoustic_offset_z}" rpy="0 0 0"/>
  </joint>
  <link name="ultrasonic_probe_link">
    <visual>
      <geometry><cylinder radius="0.025" length="0.015"/></geometry>
      <material name="turquoise"/>
    </visual>
  </link>

  <joint name="probe_camera_body_joint" type="fixed">
    <parent link="probe_rail_carriage_link"/>
    <child link="probe_camera_link"/>
    <origin xyz="${probe_camera_offset_x} 0 ${probe_camera_offset_z}" rpy="0 0 0"/>
  </joint>
  <link name="probe_camera_link">
    <visual>
      <geometry><box size="0.042 0.042 0.023"/></geometry>
      <material name="gray"/>
    </visual>
  </link>

  <!-- Optical +Z points toward steel; optical +X points image-right. -->
  <joint name="probe_camera_optical_joint" type="fixed">
    <parent link="probe_camera_link"/>
    <child link="probe_camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="${pi} 0 ${-pi/2}"/>
  </joint>
  <link name="probe_camera_color_optical_frame"/>

</robot>
