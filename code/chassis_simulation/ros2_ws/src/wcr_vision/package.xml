<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wcr_vision</name>
  <version>0.1.0</version>
  <description>Low-latency RGB-D weld localization for top and probe cameras.</description>
  <maintainer email="maintainers@example.com">project-maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>wcr_planning_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export><build_type>ament_python</build_type></export>
</package>
